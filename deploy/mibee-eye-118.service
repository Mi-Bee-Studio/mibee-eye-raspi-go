# MiBee Eye (Go) — systemd unit for the .118 test host (rpi3b-cam).
#
# Device layout on 192.168.63.118 (differs from the canonical ~/mibee-eye
# layout in mibee-eye.service): binary ~/rpi3b-cam/rpi3b-cam-arm64,
# config ~/rpi3b-cam/configs/config.yaml (the -config flag default is
# relative to WorkingDirectory), recordings under ~/rpi3b-cam/recordings.
# Camera mode is rpicamvid (system rpicam-vid) — no LD_LIBRARY_PATH needed.
#
# Install:
#   scp deploy/mibee-eye-118.service mickey@192.168.63.118:/tmp/
#   ssh mickey@192.168.63.118 'sudo mv /tmp/mibee-eye-118.service /etc/systemd/system/mibee-eye.service && sudo systemctl daemon-reload && sudo systemctl enable --now mibee-eye'
[Unit]
Description=MiBee Eye - ONVIF Camera Server (Go, rpi3b-cam @ .118)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=mickey
Group=mickey
WorkingDirectory=/home/mickey/rpi3b-cam
ExecStart=/home/mickey/rpi3b-cam/rpi3b-cam-arm64
Restart=always
RestartSec=5
# Camera access (rpicam-vid / /dev/video0).
SupplementaryGroups=video
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
